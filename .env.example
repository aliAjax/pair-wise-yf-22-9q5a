# quality-trace 环境变量样例
# 复制为 .env 后按需修改：cp .env.example .env

# Compose 项目名（容器名前缀）
COMPOSE_PROJECT_NAME=quality-trace

# 后端宿主机端口（容器内部固定 8080）
BACKEND_PORT=21114

# 数据库宿主机端口（容器内部固定 5432）
DB_PORT=54320

# 数据库凭据
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=app_db

# JWT 密钥（生产请改为随机长字符串）
JWT_SECRET=local-dev-secret-please-change-in-prod-0123456789
JWT_EXPIRATION_MS=86400000

# 限流
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
